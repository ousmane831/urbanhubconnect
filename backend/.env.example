# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=remplacez-par-une-longue-chaine-aleatoire
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,urbanhubconnect.com,www.urbanhubconnect.com
SITE_URL=https://www.urbanhubconnect.com
CORS_ALLOWED_ORIGINS=https://www.urbanhubconnect.com
CSRF_TRUSTED_ORIGINS=https://www.urbanhubconnect.com,https://urbanhubconnect.com
# Mettre True dès que le HTTPS est actif (certificat installé), sinon False (test local en http)
SECURE_SSL_REDIRECT=False
JWT_ACCESS_MINUTES=15
MAX_UPLOAD_MB=5

# --- PostgreSQL ---
POSTGRES_DB=urbanhub
POSTGRES_USER=urbanhub
POSTGRES_PASSWORD=remplacez-par-un-mot-de-passe
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- E-mail (notification des messages de contact) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
CONTACT_RECIPIENT=infosurbanhubconnect@gmail.com

# --- Premier démarrage (à retirer ensuite) ---
AUTO_MAKEMIGRATIONS=1
SEED_ON_START=1
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Frontend (valeurs de build) ---
VITE_API_URL=/api
VITE_SITE_URL=https://www.urbanhubconnect.com
