# Campagnes d'e-mails de la Coordination : envoie celles dont l'heure est venue. Installation : voir deploy/README.md.
[Unit]
Description=Urban Hub Connect - envoi des campagnes d'e-mails
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/var/www/urbanhubconnect/backend
Environment="DJANGO_SETTINGS_MODULE=config.settings.prod"
ExecStart=/var/www/urbanhubconnect/backend/env/bin/python manage.py send_campaigns
